PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rental_db
# mysqldump / mysql binaries used by backups (must be on PATH or absolute)
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
# Booking-date rules use this timezone's calendar day
APP_TIMEZONE=Asia/Manila
# Email verification codes are sent over SMTP (Gmail by default; no console fallback).
# Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Atelier Rentals <your.address@gmail.com>"
# Google OAuth Web client ID (same value as client VITE_GOOGLE_CLIENT_ID); empty disables /auth/google
GOOGLE_CLIENT_ID=
