{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "client": {
            "root": "client",
            "framework": "vite",
            "buildCommand": "node ./node_modules/vite/bin/vite.js build"
        },
        "server": {
            "root": "server",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/uploads/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}